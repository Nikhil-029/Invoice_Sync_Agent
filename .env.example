# --- LLM extraction ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# --- OCR ---
# On Windows, set the path to tesseract.exe. On Mac/Linux with tesseract
# installed via brew/apt, this can usually stay commented out.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Active connector: sheets | quickbooks | tally | none ---
ACTIVE_CONNECTOR=sheets

# --- Google Sheets connector ---
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# --- QuickBooks connector (OAuth2) ---
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_REFRESH_TOKEN=
QB_REALM_ID=
QB_ENVIRONMENT=sandbox

# --- Tally connector (local Tally instance, XML over HTTP) ---
TALLY_HOST=localhost
TALLY_PORT=9000
TALLY_COMPANY_NAME=
